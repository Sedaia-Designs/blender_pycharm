<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.sakurasedaia.BlenderDevelopment</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Blender Development</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://sakura-sedaia.com" email="sakusedaia@outlook.com">Sakura Sedaia</vendor>
    <resource-bundle>messages.MessageBundle</resource-bundle>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <h1>Blender Development for PyCharm</h1>
        <p>Create, configure, run, and debug Blender 4.2+ add-ons and extensions from PyCharm.</p>

        <h3>Key capabilities</h3>
        <ul>
            <li>Create add-on and extension projects with a source root, project metadata, Blender manifest, and optional example code.</li>
            <li>Use PyCharm's native Python environment workflow with virtual environments, optional uv environments, or existing interpreters.</li>
            <li>Install version-matched Blender API stubs into the project interpreter.</li>
            <li>Discover existing Blender installations on Windows, macOS, and Linux, or install and remove compatible versions from plugin Settings.</li>
            <li>Configure the Blender executable, source folder, add-on symlink name, launch arguments, environment variables, and reload preferences per project.</li>
            <li>Launch Blender with a dedicated run configuration and refresh the configured add-on or extension.</li>
            <li>Debug inside Blender through PyCharm with debugger attachment, reload-on-save, script execution, add-on reload, and stop commands.</li>
        </ul>

        <p><b>Compatibility:</b> PyCharm 2026.1 or newer and Blender 4.2 or newer.</p>

        <p><i>This plugin is in active pre-release development. See the <a href="https://docs.sakura-sedaia.com/blender-development/">documentation</a> for setup and current limitations, or report issues in the <a href="https://gitlab.com/sedaia-designs/blender_pycharm/-/issues">GitLab issue tracker</a>.</i></p>

        <p>The bundled Blender runtime is derived from Jacques Lucke's <a href="https://github.com/JacquesLucke/blender_vscode">Blender Development extension for Visual Studio Code</a> and adapted for PyCharm.</p>

        <p><small><i>Licensed under GPL-3.0-or-later. This project is not affiliated with or endorsed by the Blender Foundation.</i></small></p>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij</depends>
    <depends>com.intellij.modules.python</depends>
    <depends>com.intellij.modules.pycharm</depends>

    <extensionPoints>
    </extensionPoints>
    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup
                id="Blender Development Notifications"
                bundle="messages.MessageBundle"
                key="ui.notification.group.blender.development"
                displayType="BALLOON"
                isLogByDefault="true"
        />

        <toolWindow
                id="Project Blender Manager"
                anchor="right"
                factoryClass="com.sakurasedaia.blenderdevelopment.ui.toolwindow.BlenderToolWindowFactory"
                icon="/images/blenderGray.svg"
        />

        <applicationConfigurable
                id="com.sakurasedaia.blenderdevelopment.settings.plugin"
                groupId="tools"
                bundle="messages.MessageBundle"
                key="ui.settings.title"
                instance="com.sakurasedaia.blenderdevelopment.ui.settings.BlenderSettingsFactory"
        />

        <postStartupActivity implementation="com.sakurasedaia.blenderdevelopment.lib.services.ProjectConfigStartupLoader"/>

        <directoryProjectGenerator implementation="com.sakurasedaia.blenderdevelopment.wizard.BlenderProjectDirectoryGenerator" />

        <configurationType implementation="com.sakurasedaia.blenderdevelopment.run.BlenderConfigurationType"/>
        <programRunner implementation="com.sakurasedaia.blenderdevelopment.run.BlenderDebugProgramRunner"/>

        <internalFileTemplate name="Pyproject"/>
        <internalFileTemplate name="BlenderManifest"/>
        <internalFileTemplate name="GitIgnore"/>
        <internalFileTemplate name="GplLicenseV3"/>
        <internalFileTemplate name="NewProjectMainScript"/>
        <internalFileTemplate name="README"/>
        <internalFileTemplate name="BlenderDebugLaunchScript"/>
        <internalFileTemplate name="BlenderRuntimeLaunch"/>
        <internalFileTemplate name="BlenderRuntimeRepoSyncLaunch"/>

        <fileTemplateGroup implementation="com.sakurasedaia.blenderdevelopment.lib.TemplateGroupDescription"/>

    </extensions>

    <extensions defaultExtensionNs="Pythonid">
        <pythonFlavorProvider implementation="com.jetbrains.python.sdk.uv.UvSdkFlavorProvider"/>
    </extensions>

    <actions>
        <group id="Blender.RuntimeCommandsGroup" popup="true"
               class="com.sakurasedaia.blenderdevelopment.ui.actions.BlenderRuntimeCommandGroup">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="Blender.Runtime.RunScript"
                    class="com.sakurasedaia.blenderdevelopment.ui.actions.BlenderRuntimeRunScriptAction"/>
            <action id="Blender.Runtime.ReloadAddon"
                    class="com.sakurasedaia.blenderdevelopment.ui.actions.BlenderRuntimeReloadAction"/>
            <action id="Blender.Runtime.Stop"
                    class="com.sakurasedaia.blenderdevelopment.ui.actions.BlenderRuntimeStopAction"/>
        </group>

        <action id="Blender.Runtime.RunScriptFromEditor"
                class="com.sakurasedaia.blenderdevelopment.ui.actions.BlenderRuntimeRunScriptAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
