import bpy

class SEDAIA_PT_BasePycharmLaunchPanel(bpy.types.Panel):
    """A Panel to describe the environment details"""
    bl_idname = "SEDAIA_PT_pycharm_run_panel"
    bl_label = "Item"
    bl_space_type = "VIEW_3D"
    bl_region_type = "UI"
    bl_category = "Item"

    def draw(self, context):
        """Draws the panel itself"""
        self.layout.label(text="Base Run Configuration")

def register():
    """Registers the associated classes from Blender"""
    bpy.utils.register_class(SEDAIA_PT_BasePycharmLaunchPanel)

def unregister():
    """Unregisters the associated classes from Blender"""
    bpy.utils.unregister_class(SEDAIA_PT_BasePycharmLaunchPanel)

if __name__ == "__main__":
    register()